+                                       copy->buf[0]->data, AV_PIX_FMT_NV12,
+                                       frame->width, FFALIGN(frame->height, 32), 32);
+        }
+    }
+    if (ret >= 0) {
+        n1_v4l2_copy_plane(copy->data[0], copy->linesize[0],
+                           frame->data[0], frame->linesize[0],
+                           frame->width, frame->height);
+        n1_v4l2_copy_plane(copy->data[1], copy->linesize[1],
+                           frame->data[1], frame->linesize[1],
+                           2 * ((frame->width + 1) / 2), (frame->height + 1) / 2);
