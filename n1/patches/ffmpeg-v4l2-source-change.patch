+/* CPU-visible V4L2 frames still own MMAP buffers. Release those references
+ * before handing frames to a renderer that may retain them across a seek.
+ * Otherwise a single old frame pins the entire old CAPTURE allocation. */
+static int v4l2_receive_frame(AVCodecContext *avctx, AVFrame *frame)
+{
+    AVFrame *copy;
+    V4L2m2mContext *s = ((V4L2m2mPriv*)avctx->priv_data)->context;
+    int ret;
+    /* Keep the input backlog within mpv's 32-packet fallback replay cache.
+     * Wait for an output frame instead of consuming the rest of a short clip. */
+    if (s->packets_since_frame >= 24) {
+        do {
+            ret = v4l2_try_start(avctx);
+            if (ret >= 0)
+                ret = ff_v4l2_context_dequeue_frame(&s->capture, frame, 100);
+            if (ret != AVERROR(EAGAIN))
+                break;
+            av_usleep(10000);
+        } while (av_gettime_relative() - s->input_wait_start <= 4000000);
+    } else {
+        ret = v4l2_receive_frame_internal(avctx, frame);
+    }
+    if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF) {
+        if (s->packets_since_frame >= 24 &&
+            (ret == AVERROR_EOF || av_gettime_relative() - s->input_wait_start > 4000000)) {
+            av_log(avctx, AV_LOG_ERROR, "V4L2 decoder produced no frame after %u packets; requesting software fallback\n", s->packets_since_frame);
+            return AVERROR(EIO);
+        }
+    }
+    if (ret < 0)
+        return ret;
+    s->packets_since_frame = 0;
+    s->input_wait_start = 0;
+    if (frame->format != AV_PIX_FMT_NV12)
+        return ret;
+    copy = av_frame_alloc();
+    if (!copy) {
+        av_frame_unref(frame);
+        return AVERROR(ENOMEM);
+    }
+    copy->format = frame->format;
+    copy->width = frame->width;
+    copy->height = frame->height;
+    ret = av_frame_get_buffer(copy, 32);
+    if (ret >= 0)
+        ret = av_frame_copy(copy, frame);
+    if (ret >= 0)
+        ret = av_frame_copy_props(copy, frame);
+    av_frame_unref(frame);
+    if (ret >= 0)
+        av_frame_move_ref(frame, copy);
+    av_frame_free(&copy);
     return ret;
 }
 
